# Copy this file to .env and fill it in. Never commit .env.

# Required. Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your_jwt_secret_key_here

# Optional but needed for written answers, quizzes and summaries.
# Free key: https://console.groq.com  (without it, /ask still returns the matching passages)
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-20b

# Optional. Where the data lives (defaults shown).
# DATABASE_URL=sqlite:///./app.db
# CHROMA_PATH=./chroma_db
